# Optional: enables AI extraction through the OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Required before exposing /mcp to the public internet.
MCP_TOKEN=change-me-to-a-long-random-secret

# Optional. Keep * for local use; set to your app origin in production.
CORS_ORIGIN=*

PORT=8787
